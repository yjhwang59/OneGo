{
  "name": "onego-tournament-cloud",
  "private": true,
  "version": "0.0.1",
  "description": "OneGo Tournament Cloud (OTC) - Unified Board Game Event Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
