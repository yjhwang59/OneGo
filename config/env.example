# API
PORT=3875
HOST=::

# Database - 可切換本機 / 遠端
# DB_TARGET=local  → 使用 DATABASE_URL_LOCAL
# DB_TARGET=remote → 使用 DATABASE_URL_REMOTE
DB_TARGET=local
DATABASE_URL_LOCAL=postgresql://postgres:postgres@localhost:5432/onego
DATABASE_URL_REMOTE=postgresql://user:password@host:5432/onego

# NextAuth + Google（棋友註冊/登入）
NEXTAUTH_URL=http://localhost:3874
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 可選：OTC API 僅接受來自 Next 的 ensure-from-google 時帶此 secret
# OTC_SERVER_SECRET=




